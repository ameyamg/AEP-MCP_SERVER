# ── Authentication ────────────────────────────────────────────────────────────
# Option A – pre-generated bearer token (simplest for dev/testing)
AEP_ACCESS_TOKEN=

# Option B – OAuth Server-to-Server (auto-refresh; leave AEP_ACCESS_TOKEN blank)
AEP_CLIENT_ID=
AEP_CLIENT_SECRET=

# ── Required for all requests ─────────────────────────────────────────────────
AEP_API_KEY=            # same as Client ID in most setups
AEP_ORG_ID=             # IMS org ID, e.g. XXXX@AdobeOrg
AEP_SANDBOX_NAME=prod   # default sandbox

# ── RT-CDP upstream MCP server (for rtcdp_proxy.py) ──────────────────────────
# Set to the SSE endpoint of Adobe's official RT-CDP MCP server
RTCDP_MCP_URL=https://rtcdp-mcp.adobe.io/mcp

# ── Usage logging ─────────────────────────────────────────────────────────────
AEP_USAGE_LOG=aep_usage.csv
