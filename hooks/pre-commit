#!/usr/bin/env python3
"""
Pre-commit hook — blocks commits that contain AEP/Adobe credentials.

Checks every staged file for:
  - Forbidden filenames (orgs.json, .env)
  - Non-empty secret fields in JSON  (client_secret, access_token, client_id hex)
  - Non-empty credential env vars    (AEP_CLIENT_SECRET, AEP_ACCESS_TOKEN)

Install:  cp hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
Or run:   python scripts/install_hooks.py
"""

import json
import re
import subprocess
import sys
from pathlib import Path

# ── Files that must never be committed ───────────────────────────────────────
FORBIDDEN_FILES = {"orgs.json", ".env"}

# ── JSON fields whose values must be empty strings ───────────────────────────
SECRET_JSON_FIELDS = {"client_secret", "access_token"}

# ── Env-var patterns that must have no value ─────────────────────────────────
SECRET_ENV_VARS = re.compile(
    r"^(AEP_CLIENT_SECRET|AEP_ACCESS_TOKEN|AEP_CLIENT_ID)\s*=\s*\S",
    re.MULTILINE,
)

# ── Adobe client_id pattern (32-char hex) ────────────────────────────────────
CLIENT_ID_RE = re.compile(r'"client_id"\s*:\s*"([a-f0-9]{32})"')

RESET  = "\033[0m"
RED    = "\033[31m"
YELLOW = "\033[33m"


def staged_files() -> list[str]:
    result = subprocess.run(
        ["git", "diff", "--cached", "--name-only", "--diff-filter=ACM"],
        capture_output=True, text=True,
    )
    return result.stdout.strip().splitlines()


def check_file(path: str) -> list[str]:
    issues = []
    name = Path(path).name

    # Forbidden filename
    if name in FORBIDDEN_FILES:
        issues.append(f"  {RED}BLOCKED{RESET}  '{path}' must never be committed (contains credentials)")
        return issues

    try:
        content = Path(path).read_text(encoding="utf-8")
    except Exception:
        return issues

    # JSON credential fields
    if path.endswith(".json"):
        try:
            data = json.loads(content)
            _scan_json(data, path, issues)
        except json.JSONDecodeError:
            pass
        # Also catch raw pattern in case of nested/stringified JSON
        if CLIENT_ID_RE.search(content):
            issues.append(f"  {YELLOW}WARNING{RESET} '{path}' contains a non-empty client_id (32-char hex)")

    # .env-style files
    if name.startswith(".env") or path.endswith(".env"):
        if SECRET_ENV_VARS.search(content):
            issues.append(f"  {RED}BLOCKED{RESET}  '{path}' contains non-empty credential env vars")

    return issues


def _scan_json(obj, path: str, issues: list, _depth: int = 0) -> None:
    if _depth > 10:
        return
    if isinstance(obj, dict):
        for key, val in obj.items():
            if key in SECRET_JSON_FIELDS and isinstance(val, str) and val.strip():
                issues.append(
                    f"  {RED}BLOCKED{RESET}  '{path}' has non-empty '{key}' — remove before committing"
                )
            else:
                _scan_json(val, path, issues, _depth + 1)
    elif isinstance(obj, list):
        for item in obj:
            _scan_json(item, path, issues, _depth + 1)


def main() -> int:
    files = staged_files()
    if not files:
        return 0

    all_issues: list[str] = []
    for f in files:
        all_issues.extend(check_file(f))

    if all_issues:
        print(f"\n{RED}✗ Credential check failed — commit blocked{RESET}")
        for issue in all_issues:
            print(issue)
        print(f"\nFix: remove credentials from the listed files, then re-stage and commit.")
        print(f"     Credentials belong in orgs.json (gitignored) or environment variables.\n")
        return 1

    return 0


if __name__ == "__main__":
    sys.exit(main())
